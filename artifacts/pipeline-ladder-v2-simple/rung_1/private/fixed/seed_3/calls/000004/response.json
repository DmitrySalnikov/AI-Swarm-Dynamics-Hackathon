\n45:80\n46:81\n47:81\n48:84\n49:84\n50:85\n51:85\n52:85\n53:87\n54:88\n55:89\n56:89\n57:89\n58:90\n59:92\n60:92\n61:93\n62:93\n63:95\n64:96\n65:96\n66:97\n67:97\n68:98\n69:99\n70:102\n71:102\n72:103\n73:106\n74:106\n75:107\n76:107\n77:108\n78:109\n79:110\n80:110\n81:112\n82:114\n83:117\n84:119\n85:120\n86:141\n87:142\n88:143\n89:143\n90:143\n91:143\n92:144\n93:144\n94:144\n95:145\n96:145\n97:146\n98:147\n99:147\n100:148\n101:149\n102:150\n103:151\n104:152\n105:153\n106:154\n107:156\n108:157\n109:157\n110:157\n111:157\n112:158\n113:158\n114:158\n115:159\n116:161\n117:162\n118:163\n119:163\n120:164\n121:165\n122:166\n123:167\n124:168\n125:168\n126:170\n127:170\n128:170\n129:171\n130:172\n131:172\n132:172\n133:173\n134:173\n135:173\n136:174\n137:174\n138:175\n139:175\n140:176\n141:176\n142:176\n143:176\n144:177\n145:177\n146:177\n147:177\n148:178\n149:178\n150:179\n\nNow we need to compute cumulative sums. Let's do it stepwise, starting from n=1.\n\nLet S_n = sum of first n.\n\nI'll compute in increments, but careful with large numbers.\n\nWe can do a running sum:\n\nn=1: S=25\nn=2: +27 => 52\nn=3: +31 => 83\nn=4: +31 => 114\nn=5: +33 => 147\nn=6: +33 => 180\nn=7: +36 => 216\nn=8: +38 => 254\nn=9: +39 => 293\nn=10: +40 => 333\nn=11: +44 => 377\nn=12: +45 => 422\nn=13: +45 => 467\nn=14: +45 => 512\nn=15: +46 => 558\nn=16: +47 => 605\nn=17: +47 => 652\nn=18: +47 => 699\nn=19: +49 => 748\nn=20: +50 => 798\nn=21: +50 => 848\nn=22: +50 => 898\nn=23: +50 => 948\nn=24: +51 => 999\nn=25: +52 => 1051\nn=26: +53 => 1104\nn=27: +54 => 1158\nn=28: +55 => 1213\nn=29: +55 => 1268\nn=30: +59 => 1327\nn=31: +61 => 1388\nn=32: +64 => 1452\nn=33: +64 => 1516\nn=34: +65 => 1581\nn=35: +66 => 1647\nn=36: +67 => 1714\nn=37: +68 => 1782\nn=38: +70 => 1852\nn=39: +71 => 1923\nn=40: +71 => 1994\nn=41: +75 => 2069\nn=42: +76 => 2145\nn=43: +77 => 2222\nn=44: +77 => 2299\nn=45: +80 => 2379\nn=46: +81 => 2460\nn=47: +81 => 2541\nn=48: +84 => 2625\nn=49: +84 => 2709\nn=50: +85 => 2794\nn=51: +85 => 2879\nn=52: +85 => 2964\nn=53: +87 => 3051\nn=54: +88 => 3139\nn=55: +89 => 3228\nn=56: +89 => 3317\nn=57: +89 => 3406\nn=58: +90 => 3496\nn=59: +92 => 3588\nn=60: +92 => 3680\nn=61: +93 => 3773\nn=62: +93 => 3866\nn=63: +95 => 3961\nn=64: +96 => 4057\nn=65: +96 => 4153\nn=66: +97 => 4250\nn=67: +97 => 4347\nn=68: +98 => 4445\nn=69: +99 => 4544\nn=70: +102 => 4646\nn=71: +102 => 4748\nn=72: +103 => 4851\nn=73: +106 => 4957\nn=74: +106 => 5063\nn=75: +107 => 5170\nn=76: +107 => 5277\nn=77: +108 => 5385\nn=78: +109 => 5494\nn=79: +110 => 5604\nn=80: +110 => 5714\nn=81: +112 => 5826\nn=82: +114 => 5940\nn=83: +117 => 6057\nn=84: +119 => 6176\nn=85: +120 => 6296\nn=86: +141 => 6437\nn=87: +142 => 6579\nn=88: +143 => 6722\nn=89: +143 => 6865\nn=90: +143 => 7008\nn=91: +143 => 7151\nn=92: +144 => 7295\nn=93: +144 => 7439\nn=94: +144 => 7583\nn=95: +145 => 7728\nn=96: +145 => 7873\nn=97: +146 => 8019\nn=98: +147 => 8166\nn=99: +147 => 8313\nn=100: +148 => 8461\nn=101: +149 => 8610\nn=102: +150 => 8760\nn=103: +151 => 8911\nn=104: +152 => 9063\nn=105: +153 => 9216\nn=106: +154 => 9370\nn=107: +156 => 9526\nn=108: +157 => 9683\nn=109: +157 => 9840\nn=110: +157 => 9997\nn=111: +157 => 10154\nn=112: +158 => 10312\nn=113: +158 => 10470\nn=114: +158 => 10628\nn=115: +159 => 10787\nn=116: +161 => 10948\nn=117: +162 => 11110\nn=118: +163 => 11273\nn=119: +163 => 11436\nn=120: +164 => 11600\nn=121: +165 => 11765\nn=122: +166 => 11931\nn=123: +167 => 12098\nn=124: +168 => 12266\nn=125: +168 => 12434\nn=126: +170 => 12604\nn=127: +170 => 12774\nn=128: +170 => 12944\nn=129: +171 => 13115\nn=130: +172 => 13287\nn=131: +172 => 13459\nn=132: +172 => 13631\nn=133: +173 => 13804\nn=134: +173 => 13977\nn=135: +173 => 14150\nn=136: +174 => 14324\nn=137: +174 => 14498\nn=138: +175 => 14673\nn=139: +175 => 14848\nn=140: +176 => 15024\nn=141: +176 => 15200\nn=142: +176 => 15376\nn=143: +176 => 15552\nn=144: +177 => 15729\nn=145: +177 => 15906\nn=146: +177 => 16083\nn=147: +177 => 16260\nn=1