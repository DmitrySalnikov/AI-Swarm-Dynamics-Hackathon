0.24\nsin25 - μ cos25 = 0.42261826174069944 - 0.24*0.9063077870366499 = 0.42261826174069944 - 0.21751386888879598 = 0.20510439285190346\nC5 = 4.9 * 0.20510439285190346 = 1.005011524974327\n\n6: uphill: L=3.5, sin15=0.25881904510252076, cos15=0.9659258262890683, μ=0.16\nsin15 + μ cos15 = 0.25881904510252076 + 0.16*0.9659258262890683 = 0.25881904510252076 + 0.15454813220625093 = 0.4133671773087717\nC6 = -3.5 * 0.4133671773087717 = -1.446785120580701\n\n7: downhill: L=2.4, sin34=0.5591929034707469, cos34=0.8290375725550417, μ=0.37\nsin34 - μ cos34 = 0.5591929034707469 - 0.37*0.8290375725550417 = 0.5591929034707469 - 0.3067439018453654 = 0.2524490016253815\nC7 = 2.4 * 0.2524490016253815 = 0.6058776039009156\n\n8: downhill: L=11.4, sin21=0.35836794954530027, cos21=0.9335804264972017, μ=0.21\nsin21 - μ cos21 = 0.35836794954530027 - 0.21*0.9335804264972017 = 0.35836794954530027 - 0.19605188956441236 = 0.1623160599808879\nC8 = 11.4 * 0.1623160599808879 = 1.850403083782122 (11.4*0.1623160599808879=1.850403083782122)\n\n9: horizontal: L=2.7, μ=0.25 => -0.25*2.7 = -0.675\n\n10: horizontal: L=4.4, μ=0.13 => -0.13*4.4 = -0.572\n\n11: downhill: L=10.0, sin28=0.4694715627858908, cos28=0.8829475928589269, μ=0.10\nsin28 - μ cos28 = 0.4694715627858908 - 0.10*0.8829475928589269 = 0.4694715627858908 - 0.08829475928589269 = 0.3811768034999981\nC11 = 10.0 * 0.3811768034999981 = 3.811768034999981\n\n12: uphill: L=7.8, sin28=0.4694715627858908, cos28=0.8829475928589269, μ=0.12\nsin28 + μ cos28 = 0.4694715627858908 + 0.12*0.8829475928589269 = 0.4694715627858908 + 0.10595371114307123 = 0.575425273928962\nC12 = -7.8 * 0.575425273928962 = -4.488317136645904 (7.8*0.575425273928962=4.488317136645904)\n\n13: downhill: L=7.1, sin29=0.48480962024633706, cos29=0.8746197071393957, μ=0.20\nsin29 - μ cos29 = 0.48480962024633706 - 0.20*0.8746197071393957 = 0.48480962024633706 - 0.17492394142787914 = 0.3098856788184579\nC13 = 7.1 * 0.3098856788184579 = 2.200188319611051 (7.1*0.3098856788184579=2.20018831